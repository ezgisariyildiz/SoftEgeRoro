@using EgeRoro.Entity.Identity
@model IEnumerable<AppUser>

@{
    ViewData["Title"] = "Index";
}


<h1>Tüm Kullanıcılar</h1>
<a asp-action="Create" class="btn btn-sm btn-secondary">Yeni Kullanıcı Oluştur</a>
<table class="table table-sm table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Update</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Update" asp-route-id="@item.Id">Update</a>
                </td>
                <td>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>


</table>